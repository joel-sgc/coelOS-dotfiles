+/* CoelOS: the boot splash's last picture (the COELOS wordmark centred on the
+ * backdrop), so the first frame after Plymouth is identical to it. The image is
+ * raw premultiplied ARGB8888 at COEL_CAGE_SPLASH, COEL_CAGE_SPLASH_W x _H. */
+struct coel_raw_buffer {
+	struct wlr_buffer base;
+	void *data;
+	size_t stride;
+};
+
+static void
+coel_raw_destroy(struct wlr_buffer *wlr_buffer)
+{
+	struct coel_raw_buffer *buf = wl_container_of(wlr_buffer, buf, base);
+	free(buf->data);
+	free(buf);
+}
+
+static bool
+coel_raw_begin(struct wlr_buffer *wlr_buffer, uint32_t flags, void **data, uint32_t *format, size_t *stride)
+{
+	struct coel_raw_buffer *buf = wl_container_of(wlr_buffer, buf, base);
+	if (flags & WLR_BUFFER_DATA_PTR_ACCESS_WRITE) {
+		return false;
+	}
+	*data = buf->data;
+	*format = 0x34325241; /* DRM_FORMAT_ARGB8888 ('AR24'); cage doesn't link libdrm */
+	*stride = buf->stride;
+	return true;
+}
+
+static void
+coel_raw_end(struct wlr_buffer *wlr_buffer)
+{
+}
+
+static const struct wlr_buffer_impl coel_raw_impl = {
+	.destroy = coel_raw_destroy,
+	.begin_data_ptr_access = coel_raw_begin,
+	.end_data_ptr_access = coel_raw_end,
+};
+
+void
+coel_splash_init(struct cg_server *server)
+{
+	server->coel_splash = wlr_scene_tree_create(&server->scene->tree);
+	server->coel_splash_buf = NULL;
+	const char *path = getenv("COEL_CAGE_SPLASH");
+	const char *ws = getenv("COEL_CAGE_SPLASH_W");
+	const char *hs = getenv("COEL_CAGE_SPLASH_H");
+	if (!path || !ws || !hs) {
+		return;
+	}
+	int width = atoi(ws), height = atoi(hs);
+	if (width <= 0 || height <= 0) {
+		return;
+	}
+	size_t size = (size_t)width * height * 4;
+	void *data = malloc(size);
+	FILE *f = fopen(path, "rb");
+	if (!data || !f || fread(data, 1, size, f) != size) {
+		wlr_log(WLR_ERROR, "Cannot read the splash image %s", path);
+		free(data);
+		if (f) {
+			fclose(f);
+		}
+		return;
+	}
+	fclose(f);
+	struct coel_raw_buffer *buf = calloc(1, sizeof(*buf));
+	if (!buf) {
+		free(data);
+		return;
+	}
+	wlr_buffer_init(&buf->base, &coel_raw_impl, width, height);
+	buf->data = data;
+	buf->stride = (size_t)width * 4;
+	server->coel_splash_buf = &buf->base;
+}
+
+/* Centre a copy of the wordmark on the output whose layout box is given.
+ * Integer-rounded like Plymouth's script and the greeter: W/2 - w/2. */
+void
+coel_splash_place(struct cg_output *output, int x, int y, int width, int height)
+{
+	struct cg_server *server = output->server;
+	if (!server->coel_splash_buf) {
+		return;
+	}
+	if (!output->coel_splash) {
+		output->coel_splash = wlr_scene_buffer_create(server->coel_splash, server->coel_splash_buf);
+		if (!output->coel_splash) {
+			return;
+		}
+	}
+	int bw = server->coel_splash_buf->width, bh = server->coel_splash_buf->height;
+	wlr_scene_node_set_position(&output->coel_splash->node, x + width / 2 - bw / 2, y + height / 2 - bh / 2);
+}
