import Quickshell
import Quickshell.Io
import QtQuick

// ===== GREETER BACKEND =====
// Wraps Quickshell's native Quickshell.Services.Greetd (confirmed real
// against this system's installed quickshell-0.3.0, matching the
// reference doc's API almost exactly: createSession/respond/launch,
// authMessage/authFailure/readyToLaunch). Same "backend exposes a small
// interface, UI never touches the auth system directly" shape as
// lock/backends/AuthBackend.qml (PamContext), just a different real
// backend underneath.
//
// `mock` auto-enables whenever `Greetd.available` is false -- i.e. always,
// when this is launched by hand outside of an actual greetd session (see
// greeter-shell.qml) -- so the whole UI can be built and screenshot-
// verified in a normal window before any NixOS module/greetd wiring
// exists at all, matching this project's own established "hardcoded UI
// first, then real logic" convention (same real/dev split already used
// for the lock screen, just here there's only ever one surface type since
// a greeter has no analogous "real session lock protocol" to gate behind
// a flag).
//
// users/sessions load from /etc/qs-greeter/{users,sessions}.json (real
// data, generated by modules/greeter.nix from config.users.users and the
// real wayland-sessions/*.desktop files) when present, falling back to
// the hardcoded demo data below when they're not -- which is always, when
// this is run by hand for windowed preview (greeter-shell.qml) on a
// machine that hasn't switched the module in, same absolute-path FileView
// convention PowerDropdown.qml's brightness file already uses in this
// project (not a relative path -- Quickshell's own config-root sandboxing
// makes relative-path FileView resolution from a copied/rooted config
// chancy, and there's no existing precedent for it in this codebase).
Item {
  id: root

  // Real when running as the login screen: greetd hands its greeter
  // $GREETD_SOCK. By hand (greeter-shell.qml) there is none, so the whole UI
  // runs on fake data.
  readonly property bool mock: !Quickshell.env("GREETD_SOCK")

  property var users: []           // [{name, init}]
  property int selectedUserIndex: 0
  property var sessions: []        // [{id, name, exec}]
  property int selectedSessionIndex: 0

  property bool busy: false
  property var msg: null           // {icon, text, color}, same shape Lock.qml uses
  signal finished()   // a login attempt is over (success): the UI resets
  // A new session is authenticated and about to start: the screen switches to
  // it right after, and whatever this greeter shows then stays (frozen) until
  // the compositor draws. The UI settles into its "starting" picture, then
  // calls proceed(). (coel-hub waits up to 0.8 s for that.)
  signal authenticated()
  function proceed() { if (authProc.running) authProc.write("go\n"); else if (mock) mockFinish.restart(); }

  readonly property var demoUsers: [
    { name: "joelsgc", init: "J" },
  ]
  readonly property var demoSessions: [
    { id: "hyprland", name: "Hyprland", exec: "Hyprland", desktopNames: "Hyprland" },
  ]
  Component.onCompleted: {
    users = demoUsers;
    sessions = demoSessions;
    // Dev preview only: QS_GREETER_DEMO_HOLD=1 shows the "staying awake" notice.
    if (mock && Quickshell.env("QS_GREETER_DEMO_HOLD"))
      holds = [{ user: "joelsgc", who: "CoelOS launcher", why: "keep awake toggled from launcher", blocks: ["idle", "sleep"] }];
    checkEnrollment();
  }

  FileView {
    path: "/etc/qs-greeter/users.json"
    onLoaded: {
      try {
        const parsed = JSON.parse(text());
        if (parsed.length > 0) {
          root.users = parsed.map(u => ({
            name: u.name,
            label: u.displayName || u.name,
            init: (u.displayName || u.name).charAt(0).toUpperCase(),
            passwordless: !!u.passwordless,
          }));
        }
      } catch (e) {
        console.warn("GreeterBackend: malformed users.json, keeping demo data:", e);
      }
    }
    onLoadFailed: (error) => {} // file doesn't exist yet (dev preview) -- keep demo data
  }
  FileView {
    path: "/etc/qs-greeter/sessions.json"
    onLoaded: {
      try {
        const parsed = JSON.parse(text());
        if (parsed.length > 0) {
          root.sessions = parsed;
          // Default to plain "hyprland", not whatever sorts first --
          // confirmed live that "hyprland-uwsm.desktop" sorts before
          // "hyprland.desktop" alphabetically ('-' < '.' in ASCII) in
          // the shell glob modules/greeter.nix builds this list from,
          // which silently made the uwsm-managed session the default.
          // Overridden below by the real last-used session, if any.
          const i = parsed.findIndex(s => s.id === "hyprland");
          if (i !== -1) root.selectedSessionIndex = i;
          root.applySavedSession();
        }
      } catch (e) {
        console.warn("GreeterBackend: malformed sessions.json, keeping demo data:", e);
      }
    }
    onLoadFailed: (error) => {} // file doesn't exist yet (dev preview) -- keep demo data
  }

  // Remembers whichever session was last actually launched (written at
  // the end of doLaunch() below) so the greeter defaults to it instead of
  // always resetting to "hyprland" -- /var/lib/qs-greeter is real,
  // writable, persistent state reserved for exactly this in
  // modules/greeter.nix. Applied from both FileViews' onLoaded (not just
  // this one), since sessions.json and this file load asynchronously in
  // either order -- whichever finishes last is the one that can actually
  // find the matching session and apply it.
  property string savedSessionId: ""
  function applySavedSession() {
    if (root.savedSessionId === "" || root.sessions.length === 0) return;
    const i = root.sessions.findIndex(s => s.id === root.savedSessionId);
    if (i !== -1) root.selectedSessionIndex = i;
  }
  FileView {
    path: "/var/lib/qs-greeter/last-session"
    onLoaded: {
      root.savedSessionId = text().trim();
      root.applySavedSession();
    }
    onLoadFailed: (error) => {} // no session launched yet (first run) -- keep the "hyprland" default
  }

  readonly property string selectedUser: users.length > 0 ? users[selectedUserIndex].name : ""
  property string _pendingPw: ""

  function pickUser(i) { selectedUserIndex = i; }
  function sessionStep(delta) {
    selectedSessionIndex = (selectedSessionIndex + delta + sessions.length) % sessions.length;
  }

  // ----- fingerprint enrollment, per selected user -----
  // Same fprintd-list check AuthBackend.qml (the lock screen) already
  // uses, re-run whenever the selected account changes -- unlike the
  // lock screen, the greeter can switch between several real accounts,
  // so "is fingerprint available" isn't fixed for the whole session.
  property string enrollListText: ""
  readonly property bool fingerprintEnrolled: !root.mock && root.enrollListText.indexOf(" - #") !== -1
  Process {
    id: enrollProc
    command: ["fprintd-list", root.selectedUser]
    stdout: StdioCollector {
      onStreamFinished: root.enrollListText = text
    }
  }
  function checkEnrollment() {
    if (root.mock || root.selectedUser === "") return;
    enrollProc.running = false;
    enrollProc.running = true;
  }
  onSelectedUserChanged: checkEnrollment()

  // ===== signing in, through coel-hub (scripts/coel-hub.py) =====
  // This screen lives on VT1 for good and never starts a session itself. It
  // asks `coel-hub` to either
  //   - start a NEW session on a free session host (another VT), or
  //   - RESUME a running session of the same user and desktop: check the
  //     password, then unlock that session and switch to it.
  // Which one it is follows from the selection: a running session for this
  // user + desktop means a correct password resumes it.
  readonly property string hubBin: Quickshell.env("COEL_HUB_BIN") || "/run/current-system/sw/bin/coel-hub"

  // Live sessions on the session VTs: [{id, user, tty, desktop, active}].
  property var liveSessions: []
  // One session per account (like GNOME and macOS): an account that is already
  // signed in resumes its running session, whichever desktop is selected.
  readonly property var resumeTarget:
    liveSessions.find(l => l.user === selectedUser) || null
  // An account with no password (the guest): Enter alone signs in.
  readonly property bool selectedPasswordless:
    users.length > 0 && !!users[selectedUserIndex] && !!users[selectedUserIndex].passwordless
  // The stepper shows "running" for a desktop that a password would resume.
  function sessionLabel(s) {
    const running = liveSessions.some(l => l.user === selectedUser && l.desktop === s.id);
    return running ? s.name + " \u00b7 running" : s.name;
  }
  Process {
    id: sessionsProc
    command: [root.hubBin, "sessions"]
    stdout: StdioCollector {
      onStreamFinished: {
        try { root.liveSessions = JSON.parse(text); } catch (err) { root.liveSessions = []; }
      }
    }
  }
  Timer {
    interval: 2500
    repeat: true
    running: !root.mock
    triggeredOnStart: true
    onTriggered: {
      if (!sessionsProc.running) sessionsProc.running = true;
      if (!holdsProc.running) holdsProc.running = true;
    }
  }

  // What is keeping the machine awake (coel-hub holds): while something is, the
  // login screen neither dims nor suspends, and it should say so and whose it
  // is -- otherwise a screen that stays lit looks like a bug.
  property var holds: []   // [{user, who, why, blocks}]
  Process {
    id: holdsProc
    command: [root.hubBin, "holds"]
    stdout: StdioCollector {
      onStreamFinished: {
        try { root.holds = JSON.parse(text); } catch (err) { root.holds = []; }
      }
    }
  }
  readonly property string holdText: {
    if (holds.length === 0) return "";
    const label = h => (h.who === "CoelOS launcher" ? "keep awake" : h.who) + " (" + h.user + ")";
    const shown = holds.slice(0, 2).map(label).join(", ");
    return "staying awake \u00b7 " + shown + (holds.length > 2 ? " +" + (holds.length - 2) + " more" : "");
  }

  function submit(pw) {
    if (busy) return;
    busy = true;
    msg = null;
    _pendingPw = pw;
    if (mock) { mockTimer.restart(); return; }
    if (resumeTarget) {
      startAuth([hubBin, "auth", selectedUser], resumeTarget.id);
      return;
    }
    prepareLaunch();
  }

  // The PAM conversation runs inside `coel-hub auth` (JSON lines on stdio).
  // The greetd PAM stack (modules/greeter.nix) asks for the password FIRST
  // (so pam_gnome_keyring can unlock the keyring with it), then requires a
  // fingerprint as well when one is enrolled. Only the first prompt gets the
  // typed password; the fingerprint step arrives as plain info text ("place
  // your finger...") shown as a status line. A wrong password re-prompts
  // once more (pam_unix try_first_pass), which gets the already-cleared empty
  // _pendingPw and fails -- by design.
  property string _resumeId: ""
  property bool _authEnded: false
  Process {
    id: authProc
    stdinEnabled: true
    stdout: SplitParser { onRead: line => root.onAuthEvent(line) }
    onExited: (code) => {
      if (!root._authEnded) {
        root.busy = false;
        root.msg = { icon: "x", text: "login helper stopped (" + code + ")", color: "#ef596f" };
      }
    }
  }
  function startAuth(argv, resumeId) {
    _resumeId = resumeId;
    _authEnded = false;
    authProc.command = argv;
    authProc.running = true;
  }
  function onAuthEvent(line) {
    let e = null;
    try { e = JSON.parse(line); } catch (err) { return; }
    if (e.event === "prompt") {
      authProc.write(JSON.stringify({ response: root._pendingPw }) + "\n");
      root._pendingPw = "";
    } else if (e.event === "info" || e.event === "error") {
      if (e.text) root.msg = { icon: e.event === "error" ? "x" : "info", text: e.text, color: e.event === "error" ? "#ef596f" : "#5c6370" };
    } else if (e.event === "fail") {
      root._authEnded = true;
      root.busy = false;
      root.msg = { icon: "x", text: e.text || "authentication failed", color: "#ef596f" };
    } else if (e.event === "authenticated") {
      root.authenticated();
    } else if (e.event === "ok") {
      root._authEnded = true;
      if (root._resumeId !== "") {
        resumeProc.command = [root.hubBin, "resume", root._resumeId];
        resumeProc.running = true;
      } else {
        root.finish();
      }
    }
  }
  Process {
    id: resumeProc
    onExited: root.finish()
  }
  function finish() {
    busy = false;
    msg = null;
    finished();
  }

  // New session: write the launch script first, then ask the hub to start it
  // on a host. The session runs it as the real user.
  function prepareLaunch() {
    const s = sessions[selectedSessionIndex];
    // XDG_CURRENT_DESKTOP set from the session's own real DesktopNames=
    // value, not our own filename-derived s.id -- portals and Qt platform
    // theming key off the real value. PATH is explicit since the session
    // does not inherit a normal login shell's PATH, and session scripts that
    // exec bare command names (not full store paths) need it to find them.
    // XDG_SESSION_DESKTOP is what `coel-hub sessions` reports, so the next
    // login can tell "this desktop is already running".
    const envArgs = [
      "XDG_SESSION_TYPE=wayland",
      "XDG_SESSION_DESKTOP=" + s.id,
      "XDG_CURRENT_DESKTOP=" + (s.desktopNames || s.id),
      "PATH=/run/current-system/sw/bin",
    ];
    // Every session launches through a script file written to disk first and
    // only that short path is the command: a long inline `/bin/sh -c "..."`
    // argument was confirmed on real hardware to get lost before the shell
    // ran it. stdout/stderr go to a log file so a session's startup logging
    // does not flash on the bare console. The log is per user: /tmp is sticky,
    // so one shared file would not be writable for the next user to log in.
    const scriptContent =
      "#!/bin/sh\n" +
      "exec " + s.exec.trim() + " >/tmp/qs-greeter-session-" + selectedUser + ".log 2>&1\n";
    const safeScript = scriptContent.replace(/'/g, "'\\''");
    const scriptPath = "/tmp/qs-greeter-launch-" + selectedUser + ".sh";
    // Remembers this session as the one to default to next time (read back by
    // the FileView above). Written here, by the greeter user that owns
    // /var/lib/qs-greeter, not from the launch script, which runs as the
    // target user and has no write access there.
    const argv = [hubBin, "auth", selectedUser, "--host", "auto"];
    envArgs.forEach(e => { argv.push("--env"); argv.push(e); });
    argv.push("--cmd", "/bin/sh", scriptPath);
    launchScriptWriterComponent.createObject(root, {
      command: ["/bin/sh", "-c",
        "echo -n " + s.id + " > /var/lib/qs-greeter/last-session; " +
        "printf '%s' '" + safeScript + "' > " + scriptPath + " && chmod +x " + scriptPath],
      running: true,
      _argv: argv,
    });
  }

  // Starts the login only once the script file is completely written.
  Component {
    id: launchScriptWriterComponent
    Process {
      property var _argv: []
      stdout: StdioCollector {}
      onExited: {
        root.startAuth(_argv, "");
        destroy();
      }
    }
  }

  // Mock auth: "test" succeeds, anything else fails -- mirrors the
  // reference doc's own mock-mode convention.
  Timer {
    id: mockTimer
    interval: 500
    onTriggered: {
      if (root._pendingPw === "test") {
        root._pendingPw = "";
        root.authenticated();   // mock: the outro, then proceed() -> mockFinish
      } else {
        root._pendingPw = "";
        root.busy = false;
        root.msg = { icon: "x", text: "wrong password (mock: use 'test')", color: "#ef596f" };
      }
    }
  }
  Timer { id: mockFinish; interval: 100; onTriggered: root.finish() }
}
