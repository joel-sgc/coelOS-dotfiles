# Build environment for the Framework 13 AMD 7040 (azalea) EC firmware.
# Usage: see build.sh next to this file.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git xz-utils \
        cmake ninja-build device-tree-compiler gcc binutils \
        python3 python3-venv python3-pip python3-libfdt \
    && rm -rf /var/lib/apt/lists/*

# Zephyr SDK 0.16.1, ARM toolchain only (the EC is a Cortex-M4).
ARG SDK_VER=0.16.1
RUN cd /opt \
 && B=https://github.com/zephyrproject-rtos/sdk-ng/releases/download/v${SDK_VER} \
 && curl -fsSL $B/zephyr-sdk-${SDK_VER}_linux-x86_64_minimal.tar.xz | tar xJ \
 && cd zephyr-sdk-${SDK_VER} \
 && curl -fsSL $B/toolchain_linux-x86_64_arm-zephyr-eabi.tar.xz | tar xJ
ENV ZEPHYR_SDK_INSTALL_DIR=/opt/zephyr-sdk-0.16.1

# Python tooling: zmake is installed from the EC checkout at build time;
# binman (from U-Boot) packs the final ec.bin.
# pylibfdt comes from Ubuntu (python3-libfdt), hence --system-site-packages.
RUN python3 -m venv --system-site-packages /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir \
        pyelftools pykwalify colorama pyyaml jsonschema packaging \
        pycryptodomex yamllint "u-boot-pylib>=0.1.0" \
 && /opt/venv/bin/pip install --no-cache-dir --no-deps binary-manager==0.1.3 \
 && /opt/venv/bin/python -c "import libfdt" \
 && /opt/venv/bin/binman --help >/dev/null
ENV PATH=/opt/venv/bin:$PATH

COPY build-inside.sh /usr/local/bin/build-inside.sh
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/build-inside.sh"]
